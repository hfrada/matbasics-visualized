      "regions": {
        "onlyA": "hanya di $A$",
        "both": "di $A$ dan $B$",
        "onlyB": "hanya di $B$",
        "outside": "di luar $A$ dan $B$"
      },
      "operations": {
        "union": {
          "meaning": "gabungan: di $A$ atau di $B$ (boleh keduanya)",
          "rule": "A\\cup B=\\{x \\mid x \\in A \\text{ atau } x \\in B\\}"
        },
        "intersection": {
          "meaning": "irisan: di $A$ dan sekaligus di $B$",
          "rule": "A\\cap B=\\{x \\mid x \\in A \\text{ dan } x \\in B\\}"
        },
        "differenceAB": {
          "meaning": "selisih: di $A$ tetapi tidak di $B$",
          "rule": "A-B=\\{x \\mid x \\in A, x \\notin B\\}"
        },
        "differenceBA": {
          "meaning": "selisih: di $B$ tetapi tidak di $A$",
          "rule": "B-A=\\{x \\mid x \\in B, x \\notin A\\}"
        },
        "symmetric": {
          "meaning": "selisih simetris: di $A$ atau di $B$, tetapi tidak keduanya",
          "rule": "A+B=\\{x \\mid x \\in (A\\cup B), x \\notin (A\\cap B)\\}"
        },
        "complementOfUnion": {
          "meaning": "komplemen gabungan: tidak di $A$ dan tidak di $B$",
          "rule": "(A\\cup B)^C=\\{x \\in S \\mid x \\notin (A\\cup B)\\}"
        }
      },
